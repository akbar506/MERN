<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Task Project</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body>
    <div class="mx-auto p-6 border-2 bg-zinc-900 min-h-screen">
        <h1 class="text-2xl font-bold text-white">Task Project</h1>
        <div>
            <div class="form">
                <form action="/create" method="post" class="mt-3 flex flex-col gap-2">
                    <input type="text" name="task" placeholder="Enter your task"
                        class="border p-2 w-96 rounded-md bg-zinc-500">
                    <textarea name="detail" placeholder="Enter task details"
                        class="border resize-none p-2 w-96 rounded-md bg-zinc-500"></textarea>
                    <input type="submit" value="Create Task"
                        class="w-[120px] rounded-md cursor-pointer bg-blue-500 px-4 py-2">
                </form>
            </div>
            <div class="mt-4 flex gap-2 flex-wrap">
                <% if (files.length> 0) { %>
                    <% files.forEach((val)=> { %>
                        <div class="w-96 bg-zinc-500 p-4 space-y-4 rounded-md">
                            <h3 class="text-2xl">
                                <%= val %>
                            </h3>
                            <a class="text-black border px-2 py-1 rounded-md cursor-pointer text-sm"
                                href="/file/<%= val %>">Read more</a>
                        </div>
                    <% })%>
                <% } else {%>
                    <p class="text-zinc-500">No Task found</p>
                <% }%>
            </div>
        </div>
    </div>
</body>

</html>