<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>View users - CRUD with EJS</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body>
    <div class="w-full h-screen bg-zinc-900 text-white p-10">
        <div class="text-white mb-10">
            <a href="/" class="text-white">Go to home</a>
        </div>
        <h1 class="text-2xl font-bold text-white mb-3">View Users</h1>
        <div class="flex flex-wrap gap-4">
            <% if (users.length> 0) { %>
                <% users.forEach((user) => { %>
                <div class="w-80 bg-zinc-800 p-4 rounded-lg space-y-2">
                    <div class="h-64 w-full bg-zinc-700 rounded-lg">
                        <img src="<%= user.image %>" alt="img" class="h-64 w-full rounded-md object-cover object-top">
                    </div>
                    <p><%= user.name %></p>
                    <p class="text-zinc-500"><%= user.email %></p>
                    <div class="mt-5 space-x-2">
                        <a href="/edit/<%= user._id %>" class="px-3 py-2 text-sm bg-blue-500 rounded-md w-26 text-white">Edit</a>
                        <a href="/delete/<%= user._id %>" class="px-3 py-2 text-sm bg-red-500 rounded-md w-26 text-white">Delete</a>
                    </div>
                </div>
                <% }) %>
            <% } else { %>
                <p class="text-zinc-600 text-lg mt-5">No user found</p>
            <% } %>
        </div>
    </div>
</body>

</html>